{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLAE Context Demand",
  "type": "object",
  "required": [
    "task_type",
    "objective",
    "budget_tokens",
    "risk"
  ],
  "properties": {
    "task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_type": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "budget_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "code_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "test_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "docs_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "project_depth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "breadth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 25
    },
    "required_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_patterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_design": {
      "type": "boolean"
    },
    "needs_project_state": {
      "type": "boolean"
    },
    "needs_docs": {
      "type": "boolean"
    },
    "needs_tests": {
      "type": "boolean"
    }
  }
}
