{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLAE Capability",
  "type": "object",
  "required": [
    "name",
    "tier",
    "token_cost",
    "latency",
    "authority",
    "side_effects"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "tier": {
      "type": "integer",
      "minimum": 0
    },
    "token_cost": {
      "type": "integer",
      "minimum": 0
    },
    "latency": {
      "type": "string"
    },
    "authority": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "side_effects": {
      "type": "string"
    }
  }
}
