{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clae/router-output.schema.json",
  "type": "object",
  "required": [
    "intent",
    "complexity",
    "risk",
    "workflow"
  ],
  "properties": {
    "intent": {
      "enum": [
        "BRAINSTORM",
        "PROJECT",
        "CODE",
        "TEST",
        "DOCS",
        "DESIGN",
        "MIXED"
      ]
    },
    "complexity": {
      "enum": [
        "XS",
        "S",
        "M",
        "L",
        "XL"
      ]
    },
    "risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ]
    },
    "workflow": {
      "type": "string"
    },
    "required_context": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
