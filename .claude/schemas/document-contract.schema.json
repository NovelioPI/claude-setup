{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "type",
    "audience",
    "purpose",
    "covers",
    "excludes"
  ],
  "properties": {
    "type": {
      "enum": [
        "tutorial",
        "how-to",
        "reference",
        "explanation",
        "adr"
      ]
    },
    "audience": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "covers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excludes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "existing_home": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
