.DS_Store
*.swp
*~

# Secrets and machine-local config
.credentials.json
settings.local.json

# Machine-generated: regenerated by `graft init` and by Claude Code's own sync.
# Committing these breaks the next device, because they carry absolute paths.
helpers/
plugins/
.ignore

# Runtime state
.last-cleanup
.last-update-result.json
history.jsonl
backups/
cache/
file-history/
ide/
projects/
sessions/
shell-snapshots/
session-env/
daemon/
daemon*
feedback/
jobs/
mcp-needs-auth-cache.json
paste-cache/
policy-limits.json
remote/
remote-settings.json
# Only the skills written here are tracked. The rest arrive through
# `scripts/install.sh`, which fetches them from their own repositories.
skills/*
!skills/brainstorming/
!skills/brainstorming/**
!skills/milestone-run/
!skills/milestone-run/**
!skills/todo-plan/
!skills/todo-plan/**
!skills/todo-update/
!skills/todo-update/**

# Third-party agents that belong to the `impeccable` skill, which is not tracked.
agents/impeccable-*.md
tasks/
telemetry/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
