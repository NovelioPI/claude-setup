.DS_Store
*.swp
*~

# Secrets and machine-local config
.credentials.json
settings.local.json

# Machine-generated by Claude Code's own sync.
# Committing these breaks the next device, because they carry absolute paths.
helpers/
plugins/
.ignore

# Runtime state
.last-cleanup
.last-update-result.json
history.jsonl
backups/
cache/
file-history/
ide/
projects/
sessions/
shell-snapshots/
session-env/
daemon/
daemon*
feedback/
jobs/
mcp-needs-auth-cache.json
paste-cache/
policy-limits.json*
remote/
remote-settings.json
state/
remote-settings.json.synced-at
# Only the skills listed here are tracked.
skills/*
!skills/brainstorming/
!skills/brainstorming/**
!skills/tdd/
!skills/tdd/**

# Third-party agents that belong to the `impeccable` skill, which is not tracked.
agents/impeccable-*.md
tasks/
telemetry/
