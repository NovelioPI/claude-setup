{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 1
  },
  "outputStyle": "technical-style",
  "permissions": {
    "ask": [
      "Bash(git stash*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git restore*)",
      "Bash(git reset --hard*)",
      "Bash(rm *)"
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify.sh"
          }
        ]
      }
    ]
  }
}
