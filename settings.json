{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "ask": [
      "Bash(git stash*)",
      "Bash(git clean*)",
      "Bash(git checkout -- *)",
      "Bash(git restore*)",
      "Bash(git reset --hard*)",
      "Bash(rm *)"
    ]
  },
  "model": "opus",
  "env": {
    "GRAFT_NO_STATUSLINE": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-dangerous-git.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/notify.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-complexity.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/helpers/graft-hooks.cjs\" ]; then node \"$HOME/.claude/helpers/graft-hooks.cjs\" post-edit; fi",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Bash|mcp__graft__|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/helpers/graft-hooks.cjs\" ]; then node \"$HOME/.claude/helpers/graft-hooks.cjs\" tool-savings; fi",
            "timeout": 8000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/helpers/graft-hooks.cjs\" ]; then node \"$HOME/.claude/helpers/graft-hooks.cjs\" prompt; fi",
            "timeout": 15000
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/helpers/graft-hooks.cjs\" ]; then node \"$HOME/.claude/helpers/graft-hooks.cjs\" session-start; fi",
            "timeout": 8000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$HOME/.claude/helpers/graft-hooks.cjs\" ]; then node \"$HOME/.claude/helpers/graft-hooks.cjs\" stop; fi",
            "timeout": 8000
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "refreshInterval": 1
  },
  "outputStyle": "plain-style",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "high"
    }
  },
  "agentPushNotifEnabled": true
}
