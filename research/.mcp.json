{
  "mcpServers": {
    "mlflow": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "mlflow[mcp]>=3.5.1",
        "mlflow",
        "mcp",
        "run"
      ],
      "env": {
        "MLFLOW_TRACKING_URI": "${MLFLOW_TRACKING_URI:-http://localhost:5000}",
        "MLFLOW_MCP_TOOLS": "genai"
      }
    }
  }
}
